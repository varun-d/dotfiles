#!/usr/bin/env bash
# ~/.local/bin/tmx <session> [dir]
set -euo pipefail
s=${1:?usage: tmx <session> [dir]}
d=${2:-$PWD}

if ! tmux has-session -t "=$s" 2>/dev/null; then
  tmux new-session -d -s "$s" -c "$d" -n term
  tmux new-window  -t "$s:" -c "$d" -n nvim
  tmux new-window  -t "$s:" -c "$d" -n ai
  tmux new-window  -t "$s:" -c "$d" -n term
  tmux select-window -t "$s:^"   # first window, regardless of base-index
fi

if [ -n "${TMUX:-}" ]; then
  exec tmux switch-client -t "$s"
else
  exec tmux attach -t "$s"
fi
